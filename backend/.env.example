PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
NODE_ENV=development
# DEMO_MODE=true means OTPs are returned in the API response instead of sent via SMS.
# Wire up a real gateway (MSG91 / Twilio / AWS SNS free tier) before going live and set DEMO_MODE=false.
DEMO_MODE=true
# Aadhaar-based verification requires becoming a licensed UIDAI AUA/KUA (or going through
# an approved intermediary like Digilocker/Setu/Signzy). That approval process, not code,
# is the real blocker — see README.md "Identity verification" section for the phased plan
# this MVP uses instead (Voter ID number + phone OTP + manual document review by moderators).
